 {
  "name": "sm-module",
  "text": "#!name=e2e\n[Script]\ntag = type=http-response, pattern=^https://www\\.baidu\\.com/, script-path=tag.js, argument=hello\n[URL Rewrite]\n^https://www\\.baidu\\.com/paopao-reject - reject-dict\n^https://www\\.baidu\\.com/paopao-go https://www.baidu.com/robots.txt 302\n[Header Rewrite]\nhttp-response ^https://www\\.baidu\\.com/robots\\.txt header-add X-Rewritten yes\n[Map Local]\n^https://www\\.baidu\\.com/paopao-local data-type=json data=\"{\\\"local\\\":true}\" status-code=200\n[Body Rewrite]\nhttp-response ^https://www\\.baidu\\.com/robots\\.txt Baiduspider PaoPaoSpider\n[MITM]\nhostname = www.baidu.com\n",
  "fallback": "fb.sgmodule",
  "values": {},
  "spec": {
   "name": "e2e",
   "scripts": [
    {
     "name": "tag",
     "response": true,
     "pattern": "^https://www\\.baidu\\.com/",
     "url": "tag.js",
     "argument": "hello",
     "timeout": 10
    }
   ],
   "rewrites": [
    {
     "pattern": "^https://www\\.baidu\\.com/paopao-reject",
     "action": {
      "op": "reject",
      "kind": "dict"
     }
    },
    {
     "pattern": "^https://www\\.baidu\\.com/paopao-go",
     "action": {
      "op": "redirect",
      "from": "^https://www\\.baidu\\.com/paopao-go",
      "to": "https://www.baidu.com/robots.txt",
      "status": 302
     }
    },
    {
     "pattern": "^https://www\\.baidu\\.com/robots\\.txt",
     "action": {
      "op": "header",
      "ops": [
       [
        "add",
        "X-Rewritten",
        "yes",
        ""
       ]
      ]
     },
     "response": true
    },
    {
     "pattern": "^https://www\\.baidu\\.com/paopao-local",
     "action": {
      "op": "local",
      "status": 200,
      "headers": {
       "Content-Type": "application/json"
      },
      "text": "{\"local\":true}"
     }
    },
    {
     "pattern": "^https://www\\.baidu\\.com/robots\\.txt",
     "action": {
      "op": "body",
      "pairs": [
       [
        "Baiduspider",
        "PaoPaoSpider"
       ]
      ]
     },
     "response": true,
     "body": true
    }
   ],
   "hostnames": [
    "www.baidu.com"
   ],
   "rules": []
  }
