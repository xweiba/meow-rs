[
 {
  "name": "sm-surge",
  "text": "#!name=Example\n#!desc=Does things\n#!arguments=lat:31.2,lon:121.5\n[Script]\nloc = type=http-response, pattern=^https://gs-loc\\.apple\\.com/clls/wloc, requires-body=1, binary-body-mode=1, script-path=https://example.com/loc.js, argument=\"lat={{{lat}}}&lon={{{lon}}}\", timeout=5\ntick = type=cron, cronexp=\"0 * * * *\", script-path=https://example.com/cron.js\n[URL Rewrite]\n^https://ads\\.example\\.com/v1 - reject-dict\n^https://ads\\.example\\.com/img - reject-img\n^http://old\\.example\\.com/(.*) https://new.example.com/$1 302\n^https://m\\.example\\.com/(.*) https://www.example.com/$1 header\n[Header Rewrite]\nhttp-request ^https://api\\.example\\.com header-add X-Who paopao\nhttp-response ^https://api\\.example\\.com header-replace-regex Server nginx/.* nginx\n^https://api\\.example\\.com header-del Cookie\n[Map Local]\n^https://api\\.example\\.com/ads data-type=json data=\"{\\\"ads\\\":[]}\" status-code=200\n^https://api\\.example\\.com/pixel data-type=tiny-gif\n^https://api\\.example\\.com/remote data-type=json data=\"https://cdn.example.com/empty.json\"\n[Body Rewrite]\nhttp-response ^https://api\\.example\\.com/feed \"ad\":true \"ad\":false \"vip\":0 \"vip\":1\n[Rule]\nDOMAIN-SUFFIX,tracker.example,REJECT\nDOMAIN,api.example.com,PROXY\nDOMAIN,odd.example.com,SomeGroup\n[MITM]\nhostname = %APPEND% gs-loc.apple.com, *.example.com, -skip.example.com\n",
  "fallback": "fb.sgmodule",
  "values": {},
  "spec": {
   "name": "Example",
   "desc": "Does things",
   "scripts": [
    {
     "name": "loc",
     "response": true,
     "pattern": "^https://gs-loc\\.apple\\.com/clls/wloc",
     "url": "https://example.com/loc.js",
     "argument": "lat=31.2&lon=121.5",
     "binary": true,
     "body": true,
     "timeout": 5
    },
    {
     "name": "tick",
     "response": false,
     "pattern": "",
     "url": "https://example.com/cron.js",
     "timeout": 30,
     "cron": "0 * * * *"
    }
   ],
   "rewrites": [
    {
     "pattern": "^https://ads\\.example\\.com/v1",
     "action": {
      "op": "reject",
      "kind": "dict"
     }
    },
    {
     "pattern": "^https://ads\\.example\\.com/img",
     "action": {
      "op": "reject",
      "kind": "image"
     }
    },
    {
     "pattern": "^http://old\\.example\\.com/(.*)",
     "action": {
      "op": "redirect",
      "from": "^http://old\\.example\\.com/(.*)",
      "to": "https://new.example.com/$1",
      "status": 302
     }
    },
    {
     "pattern": "^https://m\\.example\\.com/(.*)",
     "action": {
      "op": "url",
      "from": "^https://m\\.example\\.com/(.*)",
      "to": "https://www.example.com/$1"
     }
    },
    {
     "pattern": "^https://api\\.example\\.com",
     "action": {
      "op": "header",
      "ops": [
       [
        "add",
        "X-Who",
        "paopao",
        ""
       ]
      ]
     }
    },
    {
     "pattern": "^https://api\\.example\\.com",
     "action": {
      "op": "header",
      "ops": [
       [
        "replace-regex",
        "Server",
        "nginx/.*",
        "nginx"
       ]
      ]
     },
     "response": true
    },
    {
     "pattern": "^https://api\\.example\\.com",
     "action": {
      "op": "header",
      "ops": [
       [
        "del",
        "Cookie",
        "",
        ""
       ]
      ]
     }
    },
    {
     "pattern": "^https://api\\.example\\.com/ads",
     "action": {
      "op": "local",
      "status": 200,
      "headers": {
       "Content-Type": "application/json"
      },
      "text": "{\"ads\":[]}"
     }
    },
    {
     "pattern": "^https://api\\.example\\.com/pixel",
     "action": {
      "op": "local",
      "status": 200,
      "headers": {
       "Content-Type": "image/gif"
      },
      "base64": "R0lGODlhAQABAIAAAP///wAAACH5BAEAAAAALAAAAAABAAEAAAICRAEAOw=="
     }
    },
    {
     "pattern": "^https://api\\.example\\.com/remote",
     "action": {
      "op": "local",
      "status": 200,
      "headers": {
       "Content-Type": "application/json"
      },
      "dataUrl": "https://cdn.example.com/empty.json"
     }
    },
    {
     "pattern": "^https://api\\.example\\.com/feed",
     "action": {
      "op": "body",
      "pairs": [
       [
        "\"ad\":true",
        "\"ad\":false"
       ],
       [
        "\"vip\":0",
        "\"vip\":1"
       ]
      ]
     },
     "response": true,
     "body": true
    }
   ],
   "hostnames": [
    "gs-loc.apple.com",
    "*.example.com"
   ],
   "excluded": [
    "skip.example.com"
   ],
   "rules": [
    "DOMAIN-SUFFIX,tracker.example,REJECT",
    "DOMAIN,api.example.com,PROXY"
   ],
   "arguments": [
    {
     "key": "lat",
     "kind": "input",
     "default": "31.2"
    },
    {
     "key": "lon",
     "kind": "input",
     "default": "121.5"
    }
   ]
  }
 },
 {
  "name": "sm-stash",
  "text": "name: Stash one\ndesc: from Stash\nhttp:\n  mitm:\n    - \"s.example.com\"\n    - \"-x.s.example.com\"\n  url-rewrite:\n    - ^https://s\\.example\\.com/ad - reject-dict\n    - ^http://s\\.example\\.com/(.*) https://s.example.com/$1 307\n  header-rewrite:\n    - http-request ^https://s\\.example\\.com header-del Referer\n  script:\n    - match: ^https://s\\.example\\.com/api\n      name: fix\n      type: response\n      require-body: true\n      timeout: 20\nscript-providers:\n  fix:\n    url: https://example.com/fix.js\n    interval: 86400\nrules:\n  - DOMAIN-SUFFIX,stash-ads.example,REJECT\n",
  "fallback": "fb.sgmodule",
  "values": {},
  "spec": {
   "name": "Stash one",
   "desc": "from Stash",
   "scripts": [
    {
     "name": "fix",
     "response": true,
     "pattern": "^https://s\\.example\\.com/api",
     "url": "https://example.com/fix.js",
     "body": true,
     "timeout": 20
    }
   ],
   "rewrites": [
    {
     "pattern": "^https://s\\.example\\.com/ad",
     "action": {
      "op": "reject",
      "kind": "dict"
     }
    },
    {
     "pattern": "^http://s\\.example\\.com/(.*)",
     "action": {
      "op": "redirect",
      "from": "^http://s\\.example\\.com/(.*)",
      "to": "https://s.example.com/$1",
      "status": 307
     }
    },
    {
     "pattern": "^https://s\\.example\\.com",
     "action": {
      "op": "header",
      "ops": [
       [
        "del",
        "Referer",
        "",
        ""
       ]
      ]
     }
    }
   ],
   "hostnames": [
    "s.example.com"
   ],
   "excluded": [
    "x.s.example.com"
   ],
   "rules": [
    "DOMAIN-SUFFIX,stash-ads.example,REJECT"
   ]
  }
 },
 {
  "name": "sm-loon",
  "text": "#!name=Loon one\n[Rule]\nDOMAIN-KEYWORD,adx,REJECT\n[Rewrite]\n^https://a\\.example\\.net/ad reject-200\n^https://a\\.example\\.net/go 302 https://b.example.net/\n^https://a\\.example\\.net/h header-add X-L 1\n^https://a\\.example\\.net/mock mock-response-body data-type=text data=\"ok\" status-code=201\n^https://a\\.example\\.net/b response-body-replace-regex foo bar\n[Script]\nhttp-request ^https://a\\.example\\.net/api script-path=req.js, requires-body=true, tag=fix, argument=x\n[Mitm]\nhostname = a.example.net\n",
  "fallback": "fb.sgmodule",
  "values": {},
  "spec": {
   "name": "Loon one",
   "scripts": [
    {
     "name": "fix",
     "response": false,
     "pattern": "^https://a\\.example\\.net/api",
     "url": "req.js",
     "argument": "x",
     "body": true,
     "timeout": 10
    }
   ],
   "rewrites": [
    {
     "pattern": "^https://a\\.example\\.net/ad",
     "action": {
      "op": "reject",
      "kind": "empty"
     }
    },
    {
     "pattern": "^https://a\\.example\\.net/go",
     "action": {
      "op": "redirect",
      "from": "^https://a\\.example\\.net/go",
      "to": "https://b.example.net/",
      "status": 302
     }
    },
    {
     "pattern": "^https://a\\.example\\.net/h",
     "action": {
      "op": "header",
      "ops": [
       [
        "add",
        "X-L",
        "1"
       ]
      ]
     }
    },
    {
     "pattern": "^https://a\\.example\\.net/mock",
     "action": {
      "op": "local",
      "status": 201,
      "headers": {
       "Content-Type": "text/plain"
      },
      "text": "ok"
     }
    },
    {
     "pattern": "^https://a\\.example\\.net/b",
     "action": {
      "op": "body",
      "pairs": [
       [
        "foo",
        "bar"
       ]
      ]
     },
     "response": true,
     "body": true
    }
   ],
   "hostnames": [
    "a.example.net"
   ],
   "rules": [
    "DOMAIN-KEYWORD,adx,REJECT"
   ]
  }
 },
