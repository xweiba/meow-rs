 {
  "name": "rs-10",
  "text": "#!name=Ads {{{mode}}}\n#!desc=Removes ads\n#!arguments=mode:fast,debug:false\n#!arguments-desc=Pick a mode\\nthen go\n#!author=me\n#!system=ios, Mac\n#!category=x\n\n[Rule]\nDOMAIN-SUFFIX,ads.example.com,REJECT\nhost,a.example.com,direct\nGEOIP,CN,whatever\nIP-CIDR,1.2.3.0/24,reject-dict,no-resolve,extra\n\n[URL Rewrite]\n^https://a\\.com/ads - reject\n^https://b\\.com/(.*) https://c.com/$1 302\n^https://d\\.com header-add X-A \"a b\"\n\n[Header Rewrite]\nhttp-response ^https://e\\.com header-replace Cache-Control no-cache\n\n[Map Local]\n^https://f\\.com/x data-type=json data=\"{}\" status-code=201 header=\"A:b|C:d\"\n^https://f\\.com/y data-type=tiny-gif\n\n[Body Rewrite]\nhttp-response ^https://g\\.com a b c d\n\n[Script]\nAd = type=http-response, pattern=^https://h\\.com, script-path=ad.js, requires-body=1, argument=m={{{mode}}}\nDaily = type=cron, cronexp=\"0 8 * * *\", script-path=daily.js\nOff = type=http-request, pattern=x, script-path=off.js, enable=false\n\n[MITM]\nhostname = %APPEND% h.com, *.i.com, -j.i.com, h.com\n",
  "fallback": "fb.sgmodule",
  "values": {},
  "spec": {
   "name": "Ads fast",
   "desc": "Removes ads",
   "scripts": [
    {
     "name": "Ad",
     "response": true,
     "pattern": "^https://h\\.com",
     "url": "ad.js",
     "argument": "m=fast",
     "body": true,
     "timeout": 10
    },
    {
     "name": "Daily",
     "response": false,
     "pattern": "",
     "url": "daily.js",
     "timeout": 30,
     "cron": "0 8 * * *"
    }
   ],
   "rewrites": [
    {
     "pattern": "^https://a\\.com/ads",
     "action": {
      "op": "reject",
      "kind": "plain"
     }
    },
    {
     "pattern": "^https://b\\.com/(.*)",
     "action": {
      "op": "redirect",
      "from": "^https://b\\.com/(.*)",
      "to": "https://c.com/$1",
      "status": 302
     }
    },
    {
     "pattern": "^https://d\\.com",
     "action": {
      "op": "header",
      "ops": [
       [
        "add",
        "X-A",
        "a b"
       ]
      ]
     }
