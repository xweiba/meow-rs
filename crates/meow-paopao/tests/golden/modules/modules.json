 {
  "name": "mf-surge",
  "text": "#!name=签到合集\n#!desc=每天自动签到 {{{城市}}}\n#!author=someone\n#!homepage=https://example.com/home\n#!icon=https://example.com/icon.png\n#!category=工具\n#!system=ios,mac\n#!openUrl=https://example.com/open\n#!arguments=城市:上海, 开启:true\n#!arguments-desc=城市: 你的城市\\n开启: 是否签到\n[Script]\ncheckin = type=cron, cronexp=\"0 8 * * *\", script-path=https://example.com/checkin.js, timeout=60, argument=city={{{城市}}}\ncookie = type=http-request, pattern=^https://api\\.example\\.com/login, script-path=https://example.com/cookie.js\noff = type=http-request, pattern=^https://x, script-path=https://example.com/off.js, enable=false\n",
  "fallback": "fb.sgmodule",
  "values": {},
  "spec": {
   "name": "签到合集",
   "desc": "每天自动签到 上海",
   "scripts": [
    {
     "name": "checkin",
     "response": false,
     "pattern": "",
     "url": "https://example.com/checkin.js",
     "argument": "city=上海",
     "timeout": 60,
     "cron": "0 8 * * *"
    },
    {
     "name": "cookie",
     "response": false,
     "pattern": "^https://api\\.example\\.com/login",
     "url": "https://example.com/cookie.js",
     "timeout": 10
    }
   ],
   "rewrites": [],
   "hostnames": [],
   "rules": [],
   "arguments": [
    {
     "key": "城市",
     "kind": "input",
     "default": "上海"
    },
    {
     "key": "开启",
     "kind": "toggle",
     "default": "true"
    }
   ],
   "argumentsHelp": "城市: 你的城市\n开启: 是否签到",
   "author": "someone",
   "homepage": "https://example.com/home",
   "icon": "https://example.com/icon.png",
   "category": "工具",
   "systems": [
    "ios",
    "mac"
   ],
   "openUrl": "https://example.com/open"
  }
 },
 {
  "name": "mf-loon",
  "text": "#!name=Loon 参数\n[Argument]\nlat = input,\"31.2\",tag=纬度,desc=十进制\non = switch,true,tag=开关\nmode = select,\"fast\",\"slow\",tag=模式\n[Script]\nhttp-response ^https://a\\.example\\.net/x script-path=https://example.com/x.js, tag=x, argument=[{lat},{mode}]\nhttp-response ^https://a\\.example\\.net/y script-path=https://example.com/y.js, tag=y, enable={on}\ncron \"*/30 * * * *\" script-path=https://example.com/c.js, tag=tick\n[Mitm]\nhostname = a.example.net\n",
  "fallback": "fb.sgmodule",
  "values": {},
  "spec": {
   "name": "Loon 参数",
   "scripts": [
    {
     "name": "x",
     "response": true,
     "pattern": "^https://a\\.example\\.net/x",
     "url": "https://example.com/x.js",
     "argument": "{\"lat\":\"31.2\",\"mode\":\"fast\"}",
     "timeout": 10,
     "argObject": true
    },
    {
     "name": "y",
     "response": true,
     "pattern": "^https://a\\.example\\.net/y",
     "url": "https://example.com/y.js",
     "timeout": 10
    },
    {
     "name": "tick",
     "response": false,
     "pattern": "",
     "url": "https://example.com/c.js",
     "timeout": 30,
     "cron": "*/30 * * * *"
    }
   ],
   "rewrites": [],
   "hostnames": [
    "a.example.net"
   ],
   "rules": [],
   "arguments": [
    {
     "key": "lat",
     "label": "纬度",
     "kind": "input",
     "default": "31.2",
     "help": "十进制"
    },
    {
     "key": "on",
     "label": "开关",
     "kind": "toggle",
     "default": "true"
    },
    {
     "key": "mode",
     "label": "模式",
     "kind": "choice",
     "default": "fast",
     "options": [
      "fast",
      "slow"
     ]
    }
   ]
  }
 },
