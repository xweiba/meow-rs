{
  "version": 1,
  "defaultDnsPolicy": "policy:ai",
  "bootstrapJsonUrls": [
    "https://223.5.5.5/resolve?name={host}&type=A",
    "https://1.1.1.1/dns-query?name={host}&type=A"
  ],
  "domesticPolicy": "policy:china",
  "domesticFallback": "DIRECT",
  "dnsFallbacks": [
    "policy:ai",
    "proxy",
    "REJECT"
  ],
  "order": [
    "speedtest-in",
    "own-app",
    "in-user",
    "private",
    "user",
    "encrypted-dns",
    "stun",
    "modules",
    "smart",
    "match"
  ],
  "templates": {
    "speedtest": "IN-NAME,{inbound},{target}",
    "ownApp": "AND,((IN-NAME,meow-tun),({app})),DIRECT",
    "inUser": "IN-USER,{user},{target}",
    "match": "MATCH,{target}"
  },
  "privateRules": [
    "IP-CIDR,10.0.0.0/8,DIRECT,no-resolve",
    "IP-CIDR,172.16.0.0/12,DIRECT,no-resolve",
    "IP-CIDR,192.168.0.0/16,DIRECT,no-resolve",
    "IP-CIDR,127.0.0.0/8,DIRECT,no-resolve",
    "IP-CIDR,169.254.0.0/16,DIRECT,no-resolve",
    "IP-CIDR,100.64.0.0/10,DIRECT,no-resolve",
    "IP-CIDR6,fc00::/7,DIRECT,no-resolve",
    "IP-CIDR6,fe80::/10,DIRECT,no-resolve",
    "IP-CIDR6,::1/128,DIRECT,no-resolve"
  ],
  "privateSites": [
    "GEOSITE,private,DIRECT"
  ],
  "encryptedDnsRules": [
    "DOMAIN-SUFFIX,dns.google,{dnsPolicy}",
    "DOMAIN-SUFFIX,cloudflare-dns.com,{dnsPolicy}",
    "DOMAIN-SUFFIX,one.one.one.one,{dnsPolicy}",
    "DOMAIN-SUFFIX,dns.quad9.net,{dnsPolicy}",
    "DOMAIN-SUFFIX,dns.nextdns.io,{dnsPolicy}",
    "DOMAIN-SUFFIX,dns.adguard-dns.com,{dnsPolicy}",
    "DOMAIN-SUFFIX,dns.adguard.com,{dnsPolicy}",
    "DOMAIN-SUFFIX,doh.opendns.com,{dnsPolicy}",
    "DOMAIN-SUFFIX,doh.cleanbrowsing.org,{dnsPolicy}",
    "DOMAIN-SUFFIX,dns.controld.com,{dnsPolicy}",
    "DOMAIN-SUFFIX,doh.pub,{dnsPolicy}",
    "DOMAIN-SUFFIX,dns.alidns.com,{dnsPolicy}",
    "AND,((DST-PORT,443),(IP-CIDR,1.1.1.1/32,no-resolve)),{dnsPolicy}",
    "AND,((DST-PORT,443),(IP-CIDR,1.0.0.1/32,no-resolve)),{dnsPolicy}",
    "AND,((DST-PORT,443),(IP-CIDR,8.8.8.8/32,no-resolve)),{dnsPolicy}",
    "AND,((DST-PORT,443),(IP-CIDR,8.8.4.4/32,no-resolve)),{dnsPolicy}",
    "AND,((DST-PORT,443),(IP-CIDR,9.9.9.9/32,no-resolve)),{dnsPolicy}",
    "AND,((DST-PORT,443),(IP-CIDR,149.112.112.112/32,no-resolve)),{dnsPolicy}",
    "AND,((DST-PORT,443),(IP-CIDR,94.140.14.14/32,no-resolve)),{dnsPolicy}",
    "AND,((DST-PORT,443),(IP-CIDR,94.140.15.15/32,no-resolve)),{dnsPolicy}",
    "AND,((DST-PORT,443),(IP-CIDR,208.67.222.222/32,no-resolve)),{dnsPolicy}",
    "AND,((DST-PORT,443),(IP-CIDR,208.67.220.220/32,no-resolve)),{dnsPolicy}",
    "AND,((DST-PORT,443),(IP-CIDR,223.5.5.5/32,no-resolve)),{dnsPolicy}",
    "AND,((DST-PORT,443),(IP-CIDR,223.6.6.6/32,no-resolve)),{dnsPolicy}",
    "AND,((DST-PORT,443),(IP-CIDR,119.29.29.29/32,no-resolve)),{dnsPolicy}",
    "AND,((DST-PORT,443),(IP-CIDR6,2606:4700:4700::1111/128,no-resolve)),{dnsPolicy}",
    "AND,((DST-PORT,443),(IP-CIDR6,2606:4700:4700::1001/128,no-resolve)),{dnsPolicy}",
    "AND,((DST-PORT,443),(IP-CIDR6,2001:4860:4860::8888/128,no-resolve)),{dnsPolicy}",
    "AND,((DST-PORT,443),(IP-CIDR6,2001:4860:4860::8844/128,no-resolve)),{dnsPolicy}",
    "AND,((DST-PORT,443),(IP-CIDR6,2620:fe::fe/128,no-resolve)),{dnsPolicy}",
    "AND,((DST-PORT,443),(IP-CIDR6,2620:fe::9/128,no-resolve)),{dnsPolicy}",
    "DST-PORT,853,{dnsPolicy}"
  ],
  "stunRules": [
    "AND,((NETWORK,UDP),(DST-PORT,3478/5349/19302-19309)),{dnsPolicy}"
  ],
  "policies": [
    {
      "group": "policy:ads",
      "base": false,
      "rules": [
        "GEOSITE,category-ads-all,policy:ads",
        "GEOSITE,category-httpdns-cn,policy:ads"
      ]
    },
    {
      "group": "policy:youtube",
      "base": false,
      "rules": [
        "AND,((NETWORK,UDP),(DST-PORT,443),(GEOSITE,youtube)),REJECT",
        "GEOSITE,youtube,policy:youtube"
      ]
    },
    {
      "group": "policy:google",
      "base": false,
      "rules": [
        "GEOSITE,google-gemini,policy:google",
        "GEOSITE,google,policy:google"
      ]
    },
    {
      "group": "policy:ai",
      "base": false,
      "rules": [
        "GEOSITE,openai,policy:ai",
        "GEOSITE,anthropic,policy:ai",
        "GEOSITE,category-ai-!cn,policy:ai",
        "GEOSITE,perplexity,policy:ai",
        "GEOSITE,xai,policy:ai",
        "DOMAIN-SUFFIX,challenges.cloudflare.com,policy:ai",
        "DOMAIN-SUFFIX,arkoselabs.com,policy:ai",
        "DOMAIN-SUFFIX,statsig.com,policy:ai",
        "DOMAIN-SUFFIX,statsigapi.net,policy:ai",
        "DOMAIN-SUFFIX,featuregates.org,policy:ai",
        "DOMAIN-SUFFIX,featureassets.org,policy:ai",
        "DOMAIN-SUFFIX,sentry.io,policy:ai",
        "DOMAIN-SUFFIX,intercom.io,policy:ai",
        "DOMAIN-SUFFIX,intercomcdn.com,policy:ai",
        "DOMAIN-SUFFIX,intercomassets.com,policy:ai",
        "DOMAIN-SUFFIX,stripe.com,policy:ai",
        "DOMAIN-SUFFIX,stripe.network,policy:ai",
        "DOMAIN-SUFFIX,auth0.com,policy:ai",
        "DOMAIN-SUFFIX,ipinfo.io,policy:ai",
        "DOMAIN-SUFFIX,ipapi.co,policy:ai",
        "DOMAIN-SUFFIX,ipapi.is,policy:ai",
        "DOMAIN-SUFFIX,ip-api.com,policy:ai",
        "DOMAIN-SUFFIX,ipify.org,policy:ai",
        "DOMAIN-SUFFIX,ipwho.is,policy:ai",
        "DOMAIN-SUFFIX,ip.sb,policy:ai",
        "DOMAIN-SUFFIX,ifconfig.me,policy:ai",
        "DOMAIN-SUFFIX,ifconfig.co,policy:ai",
        "DOMAIN-SUFFIX,icanhazip.com,policy:ai",
        "DOMAIN-SUFFIX,ipdata.co,policy:ai",
        "DOMAIN-SUFFIX,ipgeolocation.io,policy:ai",
        "DOMAIN-SUFFIX,ipregistry.co,policy:ai",
        "DOMAIN-SUFFIX,ip2location.io,policy:ai",
        "DOMAIN-SUFFIX,ip2location.com,policy:ai",
        "DOMAIN-SUFFIX,iplocation.net,policy:ai",
        "DOMAIN-SUFFIX,country.is,policy:ai",
        "DOMAIN-SUFFIX,myip.com,policy:ai",
        "DOMAIN-SUFFIX,whatismyip.com,policy:ai",
        "DOMAIN-SUFFIX,whatismyipaddress.com,policy:ai",
        "DOMAIN-SUFFIX,ipleak.net,policy:ai",
        "DOMAIN-SUFFIX,browserleaks.com,policy:ai",
        "DOMAIN-SUFFIX,whoer.net,policy:ai",
        "DOMAIN-SUFFIX,scamalytics.com,policy:ai",
        "DOMAIN-SUFFIX,ipqualityscore.com,policy:ai",
        "DOMAIN-SUFFIX,ping0.cc,policy:ai",
        "DOMAIN-SUFFIX,ippure.com,policy:ai",
        "DOMAIN-SUFFIX,ip.skk.moe,policy:ai"
      ]
    },
    {
      "group": "policy:telegram",
      "base": false,
      "rules": [
        "GEOSITE,telegram,policy:telegram",
        "IP-CIDR,91.105.192.0/23,policy:telegram,no-resolve",
        "IP-CIDR,91.108.4.0/22,policy:telegram,no-resolve",
        "IP-CIDR,91.108.8.0/22,policy:telegram,no-resolve",
        "IP-CIDR,91.108.12.0/22,policy:telegram,no-resolve",
        "IP-CIDR,91.108.16.0/22,policy:telegram,no-resolve",
        "IP-CIDR,91.108.20.0/22,policy:telegram,no-resolve",
        "IP-CIDR,91.108.56.0/22,policy:telegram,no-resolve",
        "IP-CIDR,149.154.160.0/20,policy:telegram,no-resolve",
        "IP-CIDR,185.76.151.0/24,policy:telegram,no-resolve",
        "IP-CIDR6,2001:67c:4e8::/48,policy:telegram,no-resolve",
        "IP-CIDR6,2001:b28:f23c::/48,policy:telegram,no-resolve",
        "IP-CIDR6,2001:b28:f23d::/48,policy:telegram,no-resolve",
        "IP-CIDR6,2001:b28:f23f::/48,policy:telegram,no-resolve",
        "IP-CIDR6,2a0a:f280::/32,policy:telegram,no-resolve"
      ]
    },
    {
      "group": "policy:social",
      "base": false,
      "rules": [
        "GEOSITE,twitter,policy:social",
        "GEOSITE,facebook,policy:social",
        "GEOSITE,instagram,policy:social",
        "GEOSITE,discord,policy:social",
        "GEOSITE,reddit,policy:social",
        "GEOSITE,whatsapp,policy:social",
        "GEOSITE,line,policy:social"
      ]
    },
    {
      "group": "policy:netflix",
      "base": false,
      "rules": [
        "GEOSITE,netflix,policy:netflix"
      ]
    },
    {
      "group": "policy:games",
      "base": false,
      "rules": [
        "GEOSITE,category-games@cn,{domesticPolicy}",
        "GEOSITE,steam,policy:games",
        "GEOSITE,epicgames,policy:games",
        "GEOSITE,playstation,policy:games",
        "GEOSITE,xbox,policy:games",
        "GEOSITE,nintendo,policy:games"
      ]
    },
    {
      "group": "policy:cnmedia",
      "base": false,
      "rules": [
        "GEOSITE,category-media-cn,policy:cnmedia",
        "GEOSITE,bilibili,policy:cnmedia",
        "GEOSITE,iqiyi,policy:cnmedia",
        "GEOSITE,youku,policy:cnmedia"
      ]
    },
    {
      "group": "policy:media",
      "base": false,
      "rules": [
        "GEOSITE,spotify,policy:media",
        "GEOSITE,disney,policy:media",
        "GEOSITE,hbo,policy:media",
        "GEOSITE,primevideo,policy:media",
        "GEOSITE,tiktok,policy:media",
        "GEOSITE,category-entertainment,policy:media"
      ]
    },
    {
      "group": "policy:dev",
      "base": false,
      "rules": [
        "GEOSITE,github,policy:dev",
        "GEOSITE,huggingface,policy:dev"
      ]
    },
    {
      "group": "policy:microsoft",
      "base": false,
      "rules": [
        "GEOSITE,microsoft,policy:microsoft",
        "GEOSITE,onedrive,policy:microsoft",
        "GEOSITE,bing,policy:microsoft"
      ]
    },
    {
      "group": "policy:apple",
      "base": false,
      "rules": [
        "GEOSITE,apple,policy:apple"
      ]
    },
    {
      "group": "policy:foreign",
      "base": true,
      "rules": [
        "GEOSITE,geolocation-!cn,policy:foreign"
      ]
    },
    {
      "group": "policy:china",
      "base": true,
      "rules": [
        "GEOSITE,category-games@cn,policy:china",
        "GEOSITE,cn,policy:china",
        "GEOIP,cn,policy:china",
        "PROCESS-NAME,WeChat,policy:china",
        "PROCESS-NAME,WeChatAppEx Helper,policy:china",
        "PROCESS-NAME,Weixin.exe,policy:china",
        "PROCESS-NAME,WeChat.exe,policy:china",
        "PROCESS-NAME,WeChatAppEx.exe,policy:china",
        "PROCESS-NAME,com.tencent.mm,policy:china"
      ]
    },
    {
      "group": "policy:final",
      "base": true,
      "rules": []
    }
  ],
  "finalTargets": {
    "direct": "DIRECT",
    "global": "proxy",
    "smart": "policy:final"
  },
  "dns": {
    "enable": true,
    "nameserver": [
      "https://1.1.1.1/dns-query#{dnsPolicy}",
      "https://8.8.8.8/dns-query#{dnsPolicy}"
    ],
    "default-nameserver": [
      "https://1.1.1.1/dns-query"
    ],
    "proxy-server-nameserver": [
      "https://223.5.5.5/dns-query",
      "https://1.1.1.1/dns-query"
    ]
  },
  "fakeIp": {
    "enhanced-mode": "fake-ip",
    "fake-ip-range": "198.18.0.1/16",
    "fake-ip-filter": [
      "*.lan",
      "*.local",
      "*.localdomain",
      "*.home.arpa",
      "localhost",
      "+.pool.ntp.org",
      "+.ntp.org",
      "time.cloudflare.com",
      "ntp.aliyun.com",
      "ntp.tencent.com",
      "ntp.ntsc.ac.cn",
      "connect.rom.miui.com",
      "wifi.vivo.com.cn",
      "connectivitycheck.platform.hicloud.com",
      "localhost.ptlogin2.qq.com",
      "localhost.sec.qq.com",
      "localhost.work.weixin.qq.com"
    ]
  },
  "fakeIpFilterIfDirect": {
    "policy:apple": [
      "time.apple.com",
      "time-ios.apple.com",
      "time-macos.apple.com",
      "captive.apple.com"
    ],
    "policy:microsoft": [
      "time.windows.com",
      "+.msftconnecttest.com",
      "+.msftncsi.com"
    ]
  },
  "sniffer": {
    "enable": true,
    "parse-pure-ip": true,
    "override-destination": true,
    "sniff": {
      "TLS": {
        "ports": [
          "443",
          "8443"
        ]
      },
      "HTTP": {
        "ports": [
          "80",
          "8080-8880"
        ]
      }
    },
    "skip-domain": [
      "+.push.apple.com"
    ]
  },
  "geodata": {
    "background-fetch": true,
    "auto-update": true,
    "url": {
      "mmdb": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@release/country.mmdb",
      "geosite": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@release/geosite.dat"
    }
  }
}
