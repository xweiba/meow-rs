    "DOMAIN-SUFFIX,dns.controld.com,{dnsPolicy}",
    "DOMAIN-SUFFIX,doh.pub,DIRECT",
    "DOMAIN-SUFFIX,dns.alidns.com,DIRECT",
    "AND,((DST-PORT,443),(IP-CIDR,1.1.1.1/32,no-resolve)),{dnsPolicy}",
    "AND,((DST-PORT,443),(IP-CIDR,1.0.0.1/32,no-resolve)),{dnsPolicy}",
    "AND,((DST-PORT,443),(IP-CIDR,8.8.8.8/32,no-resolve)),{dnsPolicy}",
