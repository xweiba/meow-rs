    "AND,((DST-PORT,443),(IP-CIDR,208.67.220.220/32,no-resolve)),{dnsPolicy}",
    "AND,((DST-PORT,443),(IP-CIDR,223.5.5.5/32,no-resolve)),DIRECT",
    "AND,((DST-PORT,443),(IP-CIDR,223.6.6.6/32,no-resolve)),{dnsPolicy}",
    "AND,((DST-PORT,443),(IP-CIDR,119.29.29.29/32,no-resolve)),DIRECT",
    "AND,((DST-PORT,443),(IP-CIDR6,2606:4700:4700::1111/128,no-resolve)),{dnsPolicy}",
    "AND,((DST-PORT,443),(IP-CIDR6,2606:4700:4700::1001/128,no-resolve)),{dnsPolicy}",
    "AND,((DST-PORT,443),(IP-CIDR6,2001:4860:4860::8888/128,no-resolve)),{dnsPolicy}",
    "AND,((DST-PORT,443),(IP-CIDR6,2001:4860:4860::8844/128,no-resolve)),{dnsPolicy}",
    "AND,((DST-PORT,443),(IP-CIDR6,2620:fe::fe/128,no-resolve)),{dnsPolicy}",
    "AND,((DST-PORT,443),(IP-CIDR6,2620:fe::9/128,no-resolve)),{dnsPolicy}",
    "DST-PORT,853,{dnsPolicy}"
  ],
  "stunRules": [
    "AND,((NETWORK,UDP),(DST-PORT,3478/5349/19302-19309)),{dnsPolicy}",
    "AND,((NETWORK,UDP),(DST-PORT,3478/5349/19302-19309)),REJECT"
